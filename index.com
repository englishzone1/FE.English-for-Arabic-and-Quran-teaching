<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>الاختبار النهائي — English for Arabic and Quran Teachers</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1E2A44;
    --paper:#F5ECD8;
    --paper-2:#EFE3C8;
    --card:#FFFCF3;
    --gold:#A9782B;
    --gold-deep:#8A5F1E;
    --teal:#2F6F62;
    --teal-bg:#E4EFE9;
    --brick:#AE4530;
    --brick-bg:#F6E5DF;
    --muted:#6E6250;
    --line: rgba(30,42,68,0.14);
    color-scheme: light;
  }
  :root:not([data-theme="light"]) {}
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ink:#F2ECDD;
      --paper:#22201A;
      --paper-2:#2A271F;
      --card:#2E2A22;
      --gold:#D9B15C;
      --gold-deep:#E8C87A;
      --teal:#7FBBA8;
      --teal-bg:#233A34;
      --brick:#E08E7B;
      --brick-bg:#3B2622;
      --muted:#BFB49D;
      --line: rgba(242,236,221,0.16);
    }
  }
  :root[data-theme="dark"]{
    --ink:#F2ECDD;
    --paper:#22201A;
    --paper-2:#2A271F;
    --card:#2E2A22;
    --gold:#D9B15C;
    --gold-deep:#E8C87A;
    --teal:#7FBBA8;
    --teal-bg:#233A34;
    --brick:#E08E7B;
    --brick-bg:#3B2622;
    --muted:#BFB49D;
    --line: rgba(242,236,221,0.16);
  }

  *{box-sizing:border-box;}
  html,body{height:100%;}
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  body{
    margin:0;
    min-height:100%;
    background:
      radial-gradient(1200px 700px at 15% -10%, var(--paper-2), transparent 60%),
      radial-gradient(1000px 600px at 110% 10%, var(--paper-2), transparent 55%),
      var(--paper);
    color:var(--ink);
    font-family:'Cairo', 'Segoe UI', sans-serif;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    -webkit-font-smoothing:antialiased;
  }
  .en{
    direction:ltr;
    unicode-bidi:isolate;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.98em;
  }
  .wrap{
    max-width:640px;
    margin:0 auto;
    padding: max(24px, env(safe-area-inset-top,0px)) 18px 48px;
  }
  .brand-rule{
    display:flex;
    align-items:center;
    gap:10px;
    justify-content:center;
    color:var(--gold-deep);
    margin-bottom:6px;
  }
  .brand-rule .stroke{
    height:1px;
    width:44px;
    background:linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .brand-lockup{display:flex; align-items:center; gap:10px; direction:ltr;}
  .brand-logo{width:54px; height:auto; border-radius:10px; display:block;}
  .brand-name{
    direction:ltr;
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    font-size:1.2rem;
    letter-spacing:0.06em;
    color:var(--gold-deep);
    white-space:nowrap;
  }

  /* ---------- GATE ---------- */
  .gate-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:4px;
    padding:34px 26px 30px;
    box-shadow: 0 1px 0 var(--line);
    position:relative;
    overflow:hidden;
  }
  .gate-card::before{
    content:"";
    position:absolute; inset:10px;
    border:1px solid var(--line);
    border-radius:2px;
    pointer-events:none;
  }
  .gate-title{
    font-family:'Aref Ruqaa', serif;
    font-weight:700;
    font-size:2rem;
    text-align:center;
    line-height:1.35;
    margin:6px 0 2px;
  }
  .gate-title .en-sub{
    display:block;
    font-family:'IBM Plex Mono', monospace;
    direction:ltr;
    font-size:1rem;
    color:var(--gold-deep);
    letter-spacing:0.02em;
    margin-top:10px;
  }
  .gate-course{
    text-align:center;
    color:var(--muted);
    font-size:1.02rem;
    margin-top:14px;
    line-height:1.8;
  }
  .gate-prep{
    text-align:center;
    margin-top:20px;
    padding-top:16px;
    border-top:1px solid var(--line);
    font-size:0.98rem;
    color:var(--ink);
  }
  .gate-prep b{color:var(--gold-deep);}
  .field-group{margin-top:26px;}
  label{
    display:block;
    font-size:0.92rem;
    color:var(--muted);
    margin-bottom:6px;
  }
  input[type=text], input[type=tel]{
    width:100%;
    padding:13px 14px;
    border-radius:3px;
    border:1px solid var(--line);
    background:var(--paper);
    color:var(--ink);
    font-family:'Cairo', sans-serif;
    font-size:1rem;
    margin-bottom:16px;
  }
  input:focus{outline:2px solid var(--gold); outline-offset:1px;}
  .btn{
    display:block;
    width:100%;
    text-align:center;
    padding:15px 16px;
    border:none;
    border-radius:3px;
    font-family:'Cairo', sans-serif;
    font-weight:700;
    font-size:1.05rem;
    cursor:pointer;
    transition:transform .12s ease, opacity .12s ease;
  }
  .btn:active{transform:scale(0.99);}
  .btn-primary{background:var(--gold-deep); color:var(--card);}
  .btn-primary:disabled{opacity:0.45; cursor:not-allowed;}
  .gate-note{
    text-align:center;
    font-size:0.82rem;
    color:var(--muted);
    margin-top:14px;
  }
  .hint{font-size:0.8rem;color:var(--brick);min-height:1.1em;margin:-10px 0 8px;display:none;}
  .hint.show{display:block;}

  /* ---------- QUIZ ---------- */
  #quizView{display:none;}
  .topbar{
    position:sticky; top:0;
    padding-top:env(safe-area-inset-top,0px);
    background:linear-gradient(var(--paper), var(--paper) 80%, transparent);
    z-index:5;
    padding-bottom:10px;
    margin-bottom:8px;
  }
  .meta-row{
    display:flex; justify-content:space-between; align-items:baseline;
    font-size:0.86rem; color:var(--muted); margin-bottom:8px;
  }
  .meta-row .lec{color:var(--gold-deep); font-weight:700;}
  .progress-track{
    height:6px; border-radius:4px; background:var(--paper-2);
    overflow:hidden; border:1px solid var(--line);
  }
  .progress-fill{
    height:100%; background:linear-gradient(90deg, var(--gold), var(--gold-deep));
    width:0%; transition:width .35s ease;
  }
  .q-card{
    background:var(--card);
    border-radius:4px;
    border-inline-start:4px solid var(--gold);
    border:1px solid var(--line);
    border-inline-start-width:4px;
    border-inline-start-color:var(--gold);
    padding:22px 20px 20px;
  }
  .lec-title{
    font-size:0.88rem; color:var(--muted); margin-bottom:12px;
  }
  .q-text{
    font-size:1.12rem; line-height:1.85; font-weight:600; margin-bottom:18px;
  }
  .options{display:flex; flex-direction:column; gap:10px;}
  .opt{
    text-align:right;
    padding:13px 14px;
    border:1px solid var(--line);
    border-radius:3px;
    background:var(--paper);
    cursor:pointer;
    font-family:'Cairo', sans-serif;
    font-size:0.98rem;
    line-height:1.6;
    color:var(--ink);
    display:flex;
    gap:10px;
    align-items:flex-start;
  }
  .opt .tag{
    flex-shrink:0;
    width:24px; height:24px; border-radius:50%;
    border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-size:0.78rem; color:var(--muted); font-weight:700;
    background:var(--card);
  }
  .opt:hover{border-color:var(--gold);}
  .opt.correct{background:var(--teal-bg); border-color:var(--teal);}
  .opt.correct .tag{background:var(--teal); color:#fff; border-color:var(--teal);}
  .opt.incorrect{background:var(--brick-bg); border-color:var(--brick);}
  .opt.incorrect .tag{background:var(--brick); color:#fff; border-color:var(--brick);}
  .opt.disabled{cursor:default;}
  .opt.dim{opacity:0.55;}

  .feedback{
    margin-top:16px;
    padding:15px 16px;
    border-radius:3px;
    font-size:0.94rem;
    line-height:1.85;
    display:none;
  }
  .feedback.show{display:block; animation: rise .25s ease;}
  .feedback.good{background:var(--teal-bg); border:1px solid var(--teal); color:var(--ink);}
  .feedback.bad{background:var(--brick-bg); border:1px solid var(--brick); color:var(--ink);}
  .feedback .fb-head{font-weight:800; margin-bottom:6px;}
  .feedback.good .fb-head{color:var(--teal);}
  .feedback.bad .fb-head{color:var(--brick);}
  @keyframes rise{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);}}

  .next-wrap{margin-top:18px; display:none;}
  .next-wrap.show{display:block;}

  /* ---------- RESULT ---------- */
  #resultView{display:none;}
  .score-card{
    background:var(--card); border:1px solid var(--line); border-radius:4px;
    padding:32px 22px; text-align:center;
  }
  .score-num{font-family:'Aref Ruqaa', serif; font-size:3.4rem; color:var(--gold-deep); line-height:1;}
  .score-den{font-size:1.1rem; color:var(--muted); margin-top:4px;}
  .badge{
    display:inline-block; margin-top:16px; padding:8px 20px; border-radius:20px;
    font-weight:700; font-size:0.95rem;
  }
  .badge.pass{background:var(--teal-bg); color:var(--teal); border:1px solid var(--teal);}
  .badge.fail{background:var(--brick-bg); color:var(--brick); border:1px solid var(--brick);}
  .breakdown{margin-top:26px; text-align:right;}
  .breakdown h3{font-size:0.95rem; color:var(--muted); margin-bottom:10px; font-weight:600;}
  .b-row{display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--line); font-size:0.92rem;}
  .b-row:last-child{border-bottom:none;}
  .save-status{margin-top:14px; font-size:0.86rem; color:var(--muted);}
  .save-status.ok{color:var(--teal);}
  .save-status.err{color:var(--brick);}
  .save-status a{color:var(--gold-deep); font-weight:700;}
  .weak-section{margin-top:26px; text-align:right;}
  .weak-section h3{margin:0 0 10px; font-size:1rem; color:var(--gold-deep);}
  .weak-intro{font-size:0.93rem; line-height:1.85; color:var(--muted); margin:0 0 12px;}
  .weak-item{
    border:1px solid var(--line);
    border-inline-start:4px solid var(--brick);
    background:var(--paper);
    border-radius:3px;
    padding:12px 14px;
    margin-bottom:10px;
  }
  .weak-h{font-weight:700; font-size:0.96rem; margin-bottom:4px;}
  .weak-t{font-size:0.9rem; line-height:1.85; color:var(--ink);}
  .tips{margin-top:26px; text-align:right; background:var(--paper); border:1px solid var(--line); border-radius:3px; padding:16px 18px;}
  .tips h3{margin:0 0 10px; font-size:0.98rem; color:var(--gold-deep);}
  .tips ul{margin:0; padding-inline-start:20px; line-height:1.9; font-size:0.94rem;}
  .ad-slot{
    margin-top:28px; border:1px dashed var(--line); border-radius:4px;
    padding:26px 16px; text-align:center; color:var(--muted); font-size:0.88rem;
  }
  .ad-slot.has-ad{border:none; padding:0;}
  .ad-slot img{max-width:100%; border-radius:3px; display:block; margin:0 auto;}
  .footer-note{text-align:center; color:var(--muted); font-size:0.82rem; margin-top:22px;}
</style>
</head>
<body>

<div class="wrap" id="gateView">
  <div class="brand-rule">
    <span class="stroke"></span>
    <span class="brand-lockup"><span class="brand-name">Quran Nation</span></span>
    <span class="stroke"></span>
  </div>
  <div class="gate-card">
    <div class="gate-title">
      الاختبار النهائي
      <span class="en-sub">English for Arabic &amp; Quran Teachers</span>
    </div>
    <div class="gate-course">
      لتأهيل معلمات اللغة العربية والقرآن الكريم<br>
      لتعليم غير الناطقين بها
    </div>
    <div class="gate-prep">إعداد: <b>الأستاذة أمل الحسن</b></div>

    <div class="field-group">
      <label for="sName">اسم الطالبة</label>
      <input type="text" id="sName" placeholder="اكتبي اسمك الكامل">
      <label for="sPhone">رقم الواتس</label>
      <input type="tel" id="sPhone" placeholder="مثال: 9665xxxxxxxx">
      <div class="hint" id="gateHint">فضلًا أدخلي الاسم ورقم الواتس للمتابعة.</div>
      <button class="btn btn-primary" id="startBtn">ابدئي الاختبار</button>
    </div>
    <div class="gate-note">40 سؤالًا عبر 8 محاضرات · النجاح من 60%</div>
  </div>
</div>

<div class="wrap" id="quizView">
  <div class="topbar">
    <div class="meta-row">
      <span class="lec" id="lecLabel"></span>
      <span id="qLabel"></span>
    </div>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  </div>
  <div class="q-card">
    <div class="lec-title" id="lecTitleFull"></div>
    <div class="q-text" id="qText"></div>
    <div class="options" id="optionsBox"></div>
    <div class="feedback" id="feedbackBox">
      <div class="fb-head" id="fbHead"></div>
      <div id="fbBody"></div>
    </div>
    <div class="next-wrap" id="nextWrap">
      <button class="btn btn-primary" id="nextBtn">السؤال التالي</button>
    </div>
  </div>
</div>

<div class="wrap" id="resultView">
  <div class="brand-rule">
    <span class="stroke"></span>
    <span class="brand-lockup"><span class="brand-name">Quran Nation</span></span>
    <span class="stroke"></span>
  </div>
  <div class="score-card">
    <div style="font-size:0.95rem;color:var(--muted);" id="resultName"></div>
    <div class="score-num" id="scoreNum">0%</div>
    <div class="score-den" id="scoreDen">0 من 32 إجابة صحيحة</div>
    <div class="badge" id="badge"></div>
    <div class="save-status" id="saveStatus" style="display:none"></div>

    <div class="weak-section">
      <h3 id="weakTitle"></h3>
      <div id="weakBox"></div>
    </div>

    <div class="tips">
      <h3>نصائح لكِ</h3>
      <ul id="tipsList"></ul>
    </div>

    <div class="ad-slot has-ad" id="adSlot">
      <img alt="إعلان دورة اللغة الإنجليزية — Ms. Amal Alhasan" src="data:image/jpeg;base64,">
    </div>
  </div>
  <div class="footer-note">إعداد: الأستاذة أمل الحسن — English for Arabic &amp; Quran Teachers</div>
</div>

<script>
const LECTURES = [
  {title:"المحاضرة 1", subtitle:"Greetings & Warm Welcome — الترحيب وبداية الحصة"},
  {title:"المحاضرة 2", subtitle:"Giving Simple Instructions — إعطاء التعليمات الأساسية"},
  {title:"المحاضرة 3", subtitle:"Praise, Parent Calls & Gentle Correction — التشجيع وإقناع ولية الأمر والتصحيح اللطيف والتقارير"},
  {title:"المحاضرة 4", subtitle:"Asking Questions & Checking Understanding — الأسئلة والتأكد من الفهم"},
  {title:"المحاضرة 5", subtitle:"Keeping Attention & Managing Distraction — الانتباه وضبط السلوك عبر الإنترنت"},
  {title:"المحاضرة 6", subtitle:"Ending the Lesson & Giving Homework — إنهاء الحصة وإعطاء الواجب"},
  {title:"المحاضرة 7", subtitle:"Handling Technical Issues & Small Talk — المشكلات التقنية وكسر الروتين"},
  {title:"المحاضرة 8", subtitle:"Handling Parent Complaints & Absences — شكاوى ولية الأمر والغياب"}
];

const QUESTIONS = [
// ===== Lecture 1: Greetings & Warm Welcome =====
{l:0, q:"هذه أول مرة تقابلين فيها الطفل، وتريدين معرفة اسمه بلطف. ما أنسب عبارة؟",
 o:["What is your name, sweetheart?","How are you today?","Are you ready to start our lesson?","Did you have breakfast today?"], c:0,
 tip:"العبارة الصحيحة سؤال تعارف مباشر يُستخدم في أول لقاء قبل أي سؤال آخر.",
 why:"بقية الخيارات أسئلة اطمئنان أو بدء حصة، وتأتي عادة بعد التعارف لا قبله.",
 best:"ابدئي دائمًا بالتعارف (الاسم)، ثم العمر، ثم الصف، قبل الانتقال لبدء الشرح."},

{l:0, q:"طفل يبدو متعبًا أو غير مرتاح في بداية الحصة. ما أنسب سؤال للاطمئنان عليه؟",
 o:["How are you feeling today?","Which grade are you in?","Let's begin our lesson now, shall we?","Nice to meet you! My name is Teacher..."], c:0,
 tip:"هذا السؤال من فئة «الاطمئنان على الطفل»، وهو الأنسب مع طفل يبدو متعبًا.",
 why:"بقية الخيارات تعارف أو بدء رسمي للحصة، ولا تُظهر اهتمامًا بحالته.",
 best:"اسأليها عن شعوره أولًا، فإن كان متعبًا خففي وتيرة الحصة قليلًا."},

{l:0, q:"بعد التعارف والاطمئنان، تريدين بدء الحصة رسميًا. ما أنسب عبارة؟",
 o:["Are you ready to start our lesson today?","How old are you?","Is everything okay?","I hope you had a wonderful day today."], c:0,
 tip:"هذه العبارة من فئة «بدء الحصة رسميًا»، وتأتي بعد الانتهاء من التعارف والاطمئنان.",
 why:"الخيارات الأخرى تخص مراحل سابقة (تعارف/اطمئنان) يفترض أنها استُخدمت مسبقًا.",
 best:"التزمي بالترتيب: تحية ← تعارف/اطمئنان ← بدء رسمي للحصة."},

{l:0, q:"بحسب الملاحظة اللغوية في هذه المحاضرة، من ماذا تتكون جملة الترحيب الجيدة عادة؟",
 o:["تحية + سؤال قصير + جملة تشجيعية","سؤال مفتوح فقط","أمر مباشر بدون تحية","جملة طويلة معقدة بها أكثر من فكرة"], c:0,
 tip:"التركيب البسيط والمتكرر: تحية ← سؤال قصير ← جملة تشجيعية.",
 why:"الجمل الطويلة المعقدة تصعب على المعلمة المبتدئة ولا تناسب بداية الحصة.",
 best:"استخدمي نمط: \"Hello! How are you today? I'm so happy to see you!\""},

{l:0, q:"أي من العبارات التالية مناسبة لحصة متابعة (ليست الأولى)؟",
 o:["Hello again! It's so nice to see you!","Nice to meet you! My name is Teacher [name].","This is our very first lesson together!","What is your name, sweetheart?"], c:0,
 tip:"\"Hello again!\" مخصصة لحصص المتابعة وتدل على استمرارية العلاقة مع الطفل.",
 why:"عبارات \"Nice to meet you\" و\"first lesson\" و\"What is your name\" تخص اللقاء الأول فقط.",
 best:"فرّقي دائمًا بين عبارات أول لقاء وعبارات حصص المتابعة."},

// ===== Lecture 2: Giving Simple Instructions =====
{l:1, q:"قبل شرح حرف جديد، تريدين لفت انتباه الطفل بصريًا. ما أنسب عبارة؟",
 o:["Look at me, please.","Repeat after me, please.","Turn the page, please.","Wait for me, please."], c:0,
 tip:"\"Look at me, please\" من فئة «لفت الانتباه»، وتُستخدم قبل أي شرح جديد.",
 why:"الخيارات الأخرى تخص التكرار أو التنظيم، وتأتي في مراحل لاحقة من التعليمات.",
 best:"احرصي دائمًا على لفت الانتباه البصري قبل بدء أي شرح."},

{l:1, q:"نطق الطفل الكلمة بشكل غير واضح، وتريدين منه إعادة المحاولة بلطف. ما أنسب عبارة؟",
 o:["Can you say that one more time for me?","Open your book to page five, please.","Point to the letter with your finger.","It's your turn now."], c:0,
 tip:"هذه العبارة من فئة «تعليمات النطق والتكرار» المخصصة لطلب إعادة المحاولة.",
 why:"الخيارات الأخرى تخص الكتاب أو التنظيم ولا علاقة لها بطلب إعادة النطق.",
 best:"اطلبي الإعادة بعبارة قصيرة ودودة دون إشعار الطفل بالخطأ."},

{l:1, q:"تريدين توجيه الطفل لفتح كتابه على صفحة محددة. ما أنسب عبارة؟",
 o:["Open your book to page five, please.","Watch my mouth carefully.","Let's say it together, ready?","First, listen. Then, you can try."], c:0,
 tip:"هذه تعليمة استخدام الكتاب والمواد، وهي الأنسب لهذا الموقف.",
 why:"بقية الخيارات تعليمات نطق أو تنظيم لا علاقة لها بفتح الكتاب.",
 best:"اذكري رقم الصفحة بوضوح مع \"please\" في نفس الجملة القصيرة."},

{l:1, q:"بحسب الملاحظة اللغوية، كيف يُفضَّل صياغة تعليمة طويلة للطفل؟",
 o:["تقسيمها إلى جملتين قصيرتين بدل جملة واحدة معقدة","قولها كاملة دفعة واحدة دون توقف","استخدام أكثر من فعل أمر في نفس الجملة","تجنب كلمة \"please\" لتكون أكثر حزمًا"], c:0,
 tip:"التركيب الموصى به: فعل أمر + \"please\" + تفصيل بسيط.",
 why:"الجملة الطويلة المعقدة أو المتعددة الأوامر تصعب على الطفل استيعابها.",
 best:"قسّمي أي تعليمة طويلة إلى جملتين قصيرتين ومتتاليتين."},

{l:1, q:"الطفل بدأ الكتابة قبل أن تنتهي المعلمة من الشرح. ما أنسب عبارة لتنظيم الموقف؟",
 o:["Wait for me, please, before you start.","Say it again, one more time.","Can you find this letter on the page?","Turn the page, please."], c:0,
 tip:"هذه من فئة «تعليمات الانتظار والتنظيم»، مناسبة لطلب التوقف قبل البدء.",
 why:"الخيارات الأخرى تعليمات نطق أو كتاب لا تخص تنظيم التوقيت.",
 best:"استخدمي عبارة انتظار واضحة وهادئة قبل استئناف الشرح."},

// ===== Lecture 3 (merged): Praise, Parent Calls, Gentle Correction, Reports =====
{l:2, q:"الطفل يحاول قراءة كلمة ويواجه صعوبة بسيطة في منتصف المحاولة. ما أنسب عبارة تشجيع أثناء المحاولة؟",
 o:["You're doing great, keep going!","I'm so proud of you today!","Well done!","You can do it, I believe in you!"], c:0,
 tip:"هذه العبارة من فئة «التشجيع أثناء المحاولة»، تُستخدم بينما الطفل لم ينجح بعد.",
 why:"\"Well done\" و\"I'm so proud\" تأتيان بعد النجاح، و\"I believe in you\" تُستخدم عند شعور الطفل بالاستسلام لا أثناء محاولة عادية.",
 best:"استخدمي تشجيع «أثناء المحاولة» تحديدًا وقت الصعوبة، واحتفظي بالتشجيع المطوَّل للنجاح الفعلي."},

{l:2, q:"بحسب الملاحظة اللغوية لهيكل المكالمة الناجحة مع ولية الأمر، ما الترتيب الصحيح؟",
 o:["ترحيب دافئ ← الاستماع لاحتياجات الأم ← عرض القيمة ← الرد على التردد ← دعوة الاشتراك","عرض السعر فورًا ← ثم الترحيب","التحدث عن خبرة المعلمة أولًا وباستفاضة قبل سؤال الأم عن طفلها","دعوة الاشتراك مباشرة دون سؤال أو استماع"], c:0,
 tip:"الهيكل الصحيح يبدأ بترحيب دافئ ثم الاستماع لاحتياجات الأم قبل عرض القيمة.",
 why:"الأهم ألا تتحدث المعلمة عن نفسها كثيرًا قبل أن تسأل الأم أولًا عن طفلها.",
 best:"استمعي أولًا، ثم اعرضي القيمة، ثم عالجي التردد بهدوء، ثم ادعِ للاشتراك بوضوح."},

{l:2, q:"الطفل يشعر بالإحباط ويقول: \"أخطأت مجددًا، لم أعجبني هذا!\". ما أفضل رد من المعلمة؟",
 o:["It's okay! Making mistakes means you're learning. Let's practice one more time, slowly.","You need to concentrate more.","Let's move to the next letter instead.","That's a big mistake, try to be careful."], c:0,
 tip:"الرد الصحيح يجمع بين التطمين (الخطأ جزء من التعلّم) والدعوة اللطيفة للمحاولة ببطء.",
 why:"اللوم المباشر أو تجاهل شعور الطفل بالانتقال لموضوع آخر لا يعالج الإحباط.",
 best:"طمّني الطفل أولًا، ثم ادعيه لمحاولة هادئة بلا ضغط."},

{l:2, q:"بحسب الملاحظة اللغوية، من ماذا تتكون جملة التصحيح اللطيف الجيدة؟",
 o:["جزء تطميني + جزء توضيحي","أمر مباشر بدون أي تطمين","سؤال مفتوح فقط دون توجيه","جملة طويلة تشرح كل قواعد النطق دفعة واحدة"], c:0,
 tip:"مثال: \"It's okay, everyone makes mistakes. Let's try together\" — تطمين ثم توجيه.",
 why:"الجزء الأول يقلل التوتر، والثاني يوجّه الطفل عمليًا؛ حذف أحدهما يُضعف التصحيح.",
 best:"لا تصحّحي أبدًا دون تطمين مسبق، ولا تطمّني دون توجيه عملي بعده."},

{l:2, q:"تريدين وصف نقطة تحتاج تحسينًا لولي الأمر بأسلوب لطيف غير محبط. ما الأنسب؟",
 o:["[Child's name] still needs a little more practice with [topic].","[Child's name] is not good at this at all.","I'm very disappointed with today's lesson.","[Child's name] never listens during the lesson."], c:0,
 tip:"الأسلوب اللطيف يصف نقطة التحسين بشكل محدد وإيجابي.",
 why:"العبارات المطلقة مثل \"not good at all\" أو \"never listens\" تُحمّل الطفل صفة دائمة سلبية.",
 best:"صفي السلوك في موقف محدد، لا كصفة ثابتة في الطفل."},

// ===== Lecture 4: Asking Questions & Checking Understanding =====
{l:3, q:"بحسب الملاحظة اللغوية، ما الترتيب الصحيح لتدرج الأسئلة مع الطفل المبتدئ؟",
 o:["سؤال نعم/لا ← سؤال بالإشارة (أريني/أين) ← سؤال مفتوح","سؤال مفتوح ← سؤال نعم/لا ← سؤال بالإشارة","البدء دائمًا بسؤال مفتوح صعب لتحفيز الطفل","لا يوجد ترتيب محدد، أي سؤال يصلح في أي وقت"], c:0,
 tip:"ابدئي بالأسهل (نعم/لا)، ثم سؤال الإشارة، وأخيرًا السؤال المفتوح.",
 why:"القفز مباشرة لسؤال مفتوح صعب قد يُربك الطفل المبتدئ.",
 best:"تدرّجي دائمًا من الأسهل إلى الأصعب في الأسئلة."},

{l:3, q:"تريدين التأكد أن الطفل فهم الحرف بعد الشرح مباشرة، قبل الانتقال لسؤال أصعب. ما أنسب سؤال؟",
 o:["Is this clear now?","What sound does this letter make?","Tell me in your own words, what did we learn today?","Can you think of a word that starts with this sound?"], c:0,
 tip:"سؤال نعم/لا بسيط مناسب للتأكد الأولي من الفهم.",
 why:"بقية الخيارات أسئلة مفتوحة أصعب تأتي في مرحلة لاحقة من التدرج.",
 best:"تأكدي أولًا بسؤال بسيط قبل الانتقال لسؤال أصعب."},

{l:3, q:"تريدين أن يشير الطفل بإصبعه إلى حرف معين في الصفحة. ما أنسب عبارة؟",
 o:["Can you show me? Point to it.","What is this letter?","Do you remember this word from last time?","Are you sure about your answer?"], c:0,
 tip:"هذا سؤال من فئة «أريني» يطلب إشارة فعلية للحرف.",
 why:"بقية الخيارات أسئلة مفتوحة أو تأكيدية لا تطلب إشارة جسدية.",
 best:"استخدمي أسئلة الإشارة عندما تريدين تقييمًا عمليًا لا لفظيًا."},

{l:3, q:"الطفل غير متأكد من إجابته ويقول \"ربما...\". ما أفضل رد من المعلمة؟",
 o:["It's okay, let's check together. Are you sure about your answer? Let's look again carefully.","That's wrong, try again.","Let's move to the next question.","Why don't you know the answer?"], c:0,
 tip:"الرد الصحيح يطمئن الطفل ويدعوه للتحقق معًا بهدوء.",
 why:"الحكم المباشر بالخطأ أو تجاوز الموقف أو إحراج الطفل لا يعزز ثقته.",
 best:"راجعي الإجابة معًا بهدوء بدل الحكم السريع عليها."},

{l:3, q:"تريدين أن يلخص الطفل بكلماته ما تعلمه في الحصة. ما أنسب عبارة؟",
 o:["Tell me in your own words, what did we learn today?","Do you understand? Is this clear?","Where is the letter \"Noon\" on this page?","What do you think comes next?"], c:0,
 tip:"هذا سؤال من فئة «التأكد المطوَّل» الذي يطلب تلخيصًا شخصيًا بكلمات الطفل.",
 why:"بقية الخيارات إما نعم/لا أو إشارية أو توقع بسيط، وليست طلب تلخيص.",
 best:"اطلبي التلخيص بكلمات الطفل نفسه لتقييم فهمه الحقيقي."},

// ===== Lecture 5: Keeping Attention & Managing Distraction =====
{l:4, q:"طفل يدور على كرسيه باستمرار أثناء الحصة. ما أنسب عبارة لتصحيح هذا السلوك تحديدًا؟",
 o:["Please sit still and don't spin your chair.","Look at the screen, please.","Let's take a short break, and then continue.","Are you with me?"], c:0,
 tip:"هذه عبارة من فئة «تصحيح السلوكيات الشائعة عبر الإنترنت» تخاطب سلوك لف الكرسي تحديدًا.",
 why:"\"Look at the screen\" لفت انتباه عام، و\"take a short break\" حل لاحق، و\"Are you with me?\" سؤال تأكيدي لا تصحيح سلوك.",
 best:"فرّقي بين تذكير لطيف عام وتصحيح سلوك جسدي محدد بجملة واضحة ومباشرة دون قسوة."},

{l:4, q:"الطفل يبدو متعبًا وغير مركّز في الحصة. ما أفضل رد أولي؟",
 o:["I can see that you are a little tired today, is everything alright?","Please sit still.","Eyes on me, please.","Please don't touch the camera."], c:0,
 tip:"هذا من فئة «التعامل مع تشتت مستمر»، يسأل عن السبب بلطف قبل اقتراح حل.",
 why:"بقية الخيارات تصحيحات سلوك محدد (جلوس، نظر، كاميرا) لا تعالج سبب التعب نفسه.",
 best:"اسألي عن السبب أولًا بلطف، ثم اقترحي حلًا عمليًا مثل استراحة قصيرة."},

{l:4, q:"بحسب الملاحظة اللغوية، علام تُركَّز كل الملاحظات السلوكية في هذه المحاضرة؟",
 o:["على سلوك الطفل أمام الشاشة فقط (النظر، الجلوس، الكاميرا والميكروفون)","على سلوكيات الصف التقليدي كالتحدث مع الزملاء","على الدرجات والتقييم الأكاديمي","على أسلوب الطفل في الكتابة اليدوية"], c:0,
 tip:"الحصة إلكترونية بالكامل، فجميع الملاحظات تخص سلوك الطفل أمام الشاشة لا الصف التقليدي.",
 why:"الخيارات الأخرى تخص بيئة الصف الحضوري أو جوانب أكاديمية لا علاقة لها بهذه المحاضرة.",
 best:"اربطي كل ملاحظة سلوكية بما يحدث أمام الشاشة تحديدًا (النظر، الجلوس، الكاميرا، الميكروفون)."},

{l:4, q:"الطفل يعبث بالكاميرا ويغطّيها أثناء الحصة. ما أنسب عبارة؟",
 o:["Please don't touch the camera or the microphone while we are learning.","Let's try a different activity to help you focus.","One more minute, and then we will take a short break.","Let's focus together, okay?"], c:0,
 tip:"هذه تعليمة مباشرة تخص سلوك الكاميرا تحديدًا.",
 why:"بقية الخيارات عبارات تحفيز أو تنظيم عام لا تعالج سلوك العبث بالكاميرا.",
 best:"صحّحي السلوك المحدد بجملة واضحة ومباشرة، ثم استأنفي الحصة بهدوء."},

{l:4, q:"تشتت الطفل تكرر عدة مرات رغم التذكير اللطيف. ما أنسب خطوة تالية؟",
 o:["Let's take a short break, and then continue.","Look at the screen, please.","Please sit still and don't spin your chair.","Please keep both feet on the floor."], c:0,
 tip:"مع التشتت المستمر (لا العابر) يُنصح باقتراح استراحة قصيرة بدل تكرار نفس التذكير.",
 why:"بقية الخيارات تذكيرات أولية لسلوك محدد، مناسبة في أول مرة لا بعد تكرار التشتت.",
 best:"إذا تكرر التشتت رغم التذكير، انتقلي لحل أعمق كاستراحة قصيرة أو نشاط مختلف."},

// ===== Lecture 6: Ending the Lesson & Giving Homework =====
{l:5, q:"بحسب الملاحظة اللغوية، ما الهيكل المثالي لختام الحصة؟",
 o:["إعلان الانتهاء + تلخيص إيجابي + توضيح الواجب + وداع دافئ","واجب ثم وداع فقط","وداع فقط دون تلخيص أو واجب","تلخيص سلبي للأخطاء ثم وداع"], c:0,
 tip:"هذا الترتيب الثابت يمنح الطفل شعورًا بالأمان والروتين المتكرر في نهاية كل حصة.",
 why:"حذف أي خطوة (كالتلخيص أو الواجب) يكسر الروتين الذي يحتاجه الطفل.",
 best:"التزمي دائمًا بالترتيب الرباعي الكامل في ختام كل حصة مهما كانت قصيرة."},

{l:5, q:"تريدين تلخيص إنجاز الطفل بإيجابية في نهاية الحصة. ما أنسب عبارة؟",
 o:["You worked so hard today, from start to finish!","Your homework for this week is to practice this letter.","See you next time!","We're done for today!"], c:0,
 tip:"هذه عبارة «تلخيص وتقييم إيجابي»، تأتي بعد إعلان الانتهاء وقبل شرح الواجب.",
 why:"بقية الخيارات تخص مراحل أخرى: إعلان الانتهاء، الواجب، أو الوداع.",
 best:"رتّبي كل جملة في مكانها الصحيح من الهيكل الرباعي."},

{l:5, q:"طفل لا يريد إنهاء الحصة ويطلب الاستمرار. ما أفضل رد بحسب الحوار؟",
 o:["I know how much you're enjoying this! You did amazing today. We'll continue next time, I promise.","No, we have to stop now.","Please sit still.","Let's take a short break."], c:0,
 tip:"الرد الصحيح يتفهم حماس الطفل، يمدحه، ثم يعده بالاستمرار لاحقًا بثقة.",
 why:"الرفض المباشر يحبط الطفل، والخياران الآخران غير متعلقين بالموقف إطلاقًا.",
 best:"تعاملي مع رغبة الطفل بالاستمرار بتفهم ووعد واضح، لا برفض جاف."},

{l:5, q:"تريدين شرح الواجب بوضوح لطفل في نهاية الحصة. ما أنسب عبارة؟",
 o:["Your homework for this week is to practice this letter three times.","We've done a lot of great work today.","See you soon, take care!","I'm really happy with how much you've learned today."], c:0,
 tip:"هذه عبارة «شرح الواجب» تحديدًا، وتأتي بعد التلخيص الإيجابي وقبل الوداع.",
 why:"بقية الخيارات عبارات إعلان انتهاء أو تلخيص أو وداع، لا تحدد مهمة الواجب.",
 best:"اذكري الواجب بوضوح ودقة (الحرف، عدد المرات) حتى يسهل تنفيذه بالمنزل."},

{l:5, q:"كانت الحصة صعبة بعض الشيء على الطفل. ما أفضل أسلوب ختام بحسب أحد المواقف التدريبية؟",
 o:["I know some parts were a little difficult, but you didn't give up, and that makes me very proud.","That was too hard for you today.","We'll skip homework since it was difficult.","Let's not continue next time."], c:0,
 tip:"الرد الصحيح يعترف بالصعوبة بإيجابية ويبرز مثابرة الطفل رغم ذلك.",
 why:"التصريح بأن الحصة \"كانت صعبة جدًا عليه\" يرسخ شعورًا سلبيًا، وإلغاء الواجب أو التلميح بعدم الاستمرار غير مناسبين تربويًا.",
 best:"حوّلي الصعوبة إلى نقطة فخر بالمثابرة، لا إلى حكم سلبي على قدرة الطفل."},

// ===== Lecture 7: Handling Technical Issues & Small Talk =====
{l:6, q:"صوت الطفل يتقطع أثناء الحصة. ما أنسب عبارة؟",
 o:["Your voice is cutting out a little. Let's wait a moment and try again.","Can you turn on your camera, please?","Can you type it in the chat instead?","How was your week?"], c:0,
 tip:"هذه من فئة «مشكلات الصوت» وتصف المشكلة بوضوح وهدوء مع اقتراح الانتظار والمحاولة مجددًا.",
 why:"بقية الخيارات تخص الكاميرا أو حلولًا بديلة أو حديثًا وديًا، لا مشكلة الصوت تحديدًا.",
 best:"صفي المشكلة التقنية بجملة قصيرة هادئة خالية من المصطلحات المعقدة."},

{l:6, q:"استمرت مشكلة الصوت رغم المحاولة. ما أنسب حل بديل سريع؟",
 o:["Can you type it in the chat instead?","I think your camera is off.","Let's try to reconnect.","I missed talking with you!"], c:0,
 tip:"هذا حل بديل سريع يحافظ على سير الحصة رغم استمرار مشكلة الصوت.",
 why:"\"camera is off\" و\"reconnect\" تخصان مشكلات أخرى، و\"I missed talking with you\" جملة Small Talk لا علاقة لها بحل تقني.",
 best:"إذا فشلت الحلول الأولى، انتقلي لبديل عملي كالكتابة في المحادثة النصية."},

{l:6, q:"بحسب الملاحظة اللغوية، متى تُستخدم جمل الـ Small Talk؟",
 o:["في بداية الحصص المتكررة، وليس الحصة الأولى","في كل حصة بما فيها الأولى","فقط عند حدوث عطل تقني","في نهاية كل حصة بدل الوداع"], c:0,
 tip:"الهدف من الـ Small Talk كسر الروتين وتوطيد العلاقة، ويُستخدم تحديدًا في حصص المتابعة.",
 why:"استخدامها في الحصة الأولى سابق لأوانه، وربطها بالعطل التقني أو جعلها بديلًا عن الوداع يخرج عن وظيفتها الأساسية.",
 best:"افتحي حصص المتابعة بحديث ودي قصير عن أسبوع الطفل قبل بدء الدرس."},

{l:6, q:"الطفل هو من يبدأ الحديث الودي ويشارك قصة عن يومه. ما أفضل رد بحسب الحوار النموذجي؟",
 o:["Ooh, tell me! I love hearing about your day.","Let's start the lesson now, please.","Can you hear me now?","Don't worry, this happens sometimes."], c:0,
 tip:"الرد الصحيح يستقبل حماس الطفل بحفاوة قبل الانتقال التدريجي للدرس.",
 why:"الانتقال الفوري للدرس دون تفاعل يفوّت فرصة بناء العلاقة، والخياران الآخران تقنيان لا علاقة لهما بالموقف.",
 best:"استقبلي حديث الطفل الودي بحماس حقيقي قبل أن تنتقلي للدرس بلطف."},

{l:6, q:"انقطع الإنترنت في منتصف الحصة. ما أنسب عبارة فور حدوث ذلك؟",
 o:["My internet is a little slow, one moment please.","Please look at the screen, not around the room.","That's all for today's lesson!","Tell me one good thing that happened this week."], c:0,
 tip:"هذه عبارة مباشرة وهادئة تصف المشكلة التقنية فور حدوثها.",
 why:"بقية الخيارات تخص سلوك الانتباه أو ختام الحصة أو حديثًا وديًا، لا مشكلة الاتصال.",
