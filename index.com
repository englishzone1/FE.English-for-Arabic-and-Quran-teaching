// ================== ربط جوجل شيت ==================
// ألصقي هنا رابط Web App الذي يعطيه لكِ Google Apps Script بعد النشر (ينتهي بـ /exec)
const SHEET_URL = "https://script.google.com/macros/s/AKfycbwlx28D2iRT_-UfWDuiXLHYk7HYI_b6hhU6m2xLe5nwey8qogK_6qUd_4Dzy3pGb50gcw/exec";

function sheetEnabled(){ return SHEET_URL && SHEET_URL.indexOf("http") === 0; }

function buildPayload(){
  const letters = ["أ","ب","ج","د"];
  let score = 0;
  const rows = QUESTIONS.map((item, i)=>{
    const pos = answers[i];
    const ok = pos === correctPos[i];
    if(ok) score++;
    const chosen = pos === null ? "(بدون إجابة)" : item.o[order[i][pos]];
    return (ok ? "✓ " : "✗ ") + "[" + (pos === null ? "-" : letters[pos]) + "] " + chosen;
  });
  const pct = Math.round(score / QUESTIONS.length * 100);
  return {
    name: studentName,
    phone: studentPhone,
    score: score,
    total: QUESTIONS.length,
    percent: pct,
    result: pct >= 60 ? "ناجحة" : "غير ناجحة",
    headers: QUESTIONS.map((q, i)=> "س" + (i+1) + " (م" + (q.l+1) + "): " + q.q.slice(0, 45)),
    answers: rows,
    details: QUESTIONS.map((q, i)=>{
      const pos = answers[i];
      return {
        n: i + 1,
        lecture: q.l + 1,
        q: q.q,
        chosen: pos === null ? "(بدون إجابة)" : q.o[order[i][pos]],
        correct: q.o[q.c],
        ok: pos === correctPos[i] ? "صحيحة" : "خاطئة"
      };
    })
  };
}

async function sendToSheet(){
  const st = document.getElementById('saveStatus');
  if(!sheetEnabled()){ st.style.display = 'none'; return; }
  st.style.display = 'block';
  st.className = 'save-status';
  st.textContent = "جارٍ إرسال نتيجتك إلى المعلمة...";
  try{
    await fetch(SHEET_URL, {
      method: "POST",
      mode: "no-cors",
      headers: {"Content-Type": "text/plain;charset=utf-8"},
      body: JSON.stringify(buildPayload())
    });
    st.className = 'save-status ok';
    st.textContent = "تم إرسال نتيجتك إلى المعلمة ✓";
  }catch(err){
    st.className = 'save-status err';
    st.innerHTML = 'تعذّر إرسال النتيجة. تأكدي من الاتصال بالإنترنت ثم <a href="#" id="retrySend">أعيدي المحاولة</a>';
    document.getElementById('retrySend').addEventListener('click', (e)=>{ e.preventDefault(); sendToSheet(); });
  }
}
// =================================================

// ---------- State ----------
let current = 0;
let answers = new Array(QUESTIONS.length).fill(null);   // chosen display position
let studentName = "";
let studentPhone = "";
let order = [];      // order[i] = array mapping display position -> original option index
let correctPos = []; // correctPos[i] = display position of the correct answer

function shuffle(arr){
  for(let i = arr.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// Balanced random placement: each position (0-3) gets the correct answer equally often,
// and the same position never repeats more than twice in a row.
function buildLayout(){
  let positions;
  let ok = false;
  while(!ok){
    positions = [];
    for(let p = 0; p < 4; p++){ for(let k = 0; k < QUESTIONS.length / 4; k++) positions.push(p); }
    shuffle(positions);
    ok = true;
    for(let i = 2; i < positions.length; i++){
      if(positions[i] === positions[i-1] && positions[i] === positions[i-2]){ ok = false; break; }
    }
  }
  correctPos = positions;
  order = QUESTIONS.map((item, i)=>{
    const wrongIdx = shuffle([0,1,2,3].filter(x => x !== item.c));
    const arr = new Array(4);
    arr[positions[i]] = item.c;
    let w = 0;
    for(let p = 0; p < 4; p++){ if(p !== positions[i]) arr[p] = wrongIdx[w++]; }
    return arr;
  });
}

const gateView = document.getElementById('gateView');
const quizView = document.getElementById('quizView');
const resultView = document.getElementById('resultView');

document.getElementById('startBtn').addEventListener('click', ()=>{
  const name = document.getElementById('sName').value.trim();
  const phone = document.getElementById('sPhone').value.trim();
  const hint = document.getElementById('gateHint');
  if(!name || !phone){
    hint.classList.add('show');
    return;
  }
  hint.classList.remove('show');
  studentName = name;
  studentPhone = phone;
  buildLayout();
  gateView.style.display = 'none';
  quizView.style.display = 'block';
  renderQuestion();
});

function renderQuestion(){
  const item = QUESTIONS[current];
  const lec = LECTURES[item.l];
  document.getElementById('lecLabel').textContent = "المحاضرة " + (item.l+1) + " من 4";
  document.getElementById('qLabel').textContent = "سؤال " + (current+1) + " من " + QUESTIONS.length;
  document.getElementById('progressFill').style.width = Math.round(((current)/QUESTIONS.length)*100) + "%";
  document.getElementById('lecTitleFull').textContent = lec.subtitle;
  document.getElementById('qText').textContent = item.q;

  const box = document.getElementById('optionsBox');
  box.innerHTML = "";
  const letters = ["أ","ب","ج","د"];
  order[current].forEach((origIdx, idx)=>{
    const optText = item.o[origIdx];
    const div = document.createElement('div');
    div.className = 'opt';
    div.dataset.idx = idx;
    const isEnglish = /[A-Za-z]/.test(optText);
    div.innerHTML = '<span class="tag">'+letters[idx]+'</span><span class="'+(isEnglish?'en':'')+'">'+optText.replace(/</g,'&lt;')+'</span>';
    div.addEventListener('click', ()=>selectOption(idx));
    box.appendChild(div);
  });

  document.getElementById('feedbackBox').classList.remove('show','good','bad');
  document.getElementById('nextWrap').classList.remove('show');

  // if already answered (in case of back navigation, not used but safe)
  if(answers[current] !== null){
    showFeedback(answers[current]);
  }
}

function selectOption(idx){
  if(answers[current] !== null) return; // already answered
  answers[current] = idx;
  showFeedback(idx);
}

function showFeedback(idx){
  const item = QUESTIONS[current];
  const opts = document.querySelectorAll('#optionsBox .opt');
  opts.forEach((el)=>{
    const i = parseInt(el.dataset.idx);
    el.classList.add('disabled');
    if(i === correctPos[current]){ el.classList.add('correct'); }
    if(i === idx && idx !== correctPos[current]){ el.classList.add('incorrect'); }
    if(i !== idx && i !== correctPos[current]){ el.classList.add('dim'); }
  });

  const fb = document.getElementById('feedbackBox');
  const head = document.getElementById('fbHead');
  const body = document.getElementById('fbBody');
  const isCorrect = idx === correctPos[current];

  if(isCorrect){
    fb.classList.add('show','good');
    fb.classList.remove('bad');
    head.textContent = "✅ إجابة صحيحة";
    body.innerHTML = item.tip + "<br><br><b>أفضل ممارسة:</b> " + item.best;
  } else {
    fb.classList.add('show','bad');
    fb.classList.remove('good');
    head.textContent = "✗ ليست الأدق";
    body.innerHTML =
      "<b>لماذا هذا غير دقيق:</b> " + item.why +
      "<br><br><b>الإجابة الصحيحة:</b> " + item.tip +
      "<br><br><b>أفضل طريقة للرد في هذا الموقف:</b> " + item.best;
  }

  const nextWrap = document.getElementById('nextWrap');
  nextWrap.classList.add('show');
  document.getElementById('nextBtn').textContent =
    (current === QUESTIONS.length - 1) ? "إظهار النتيجة" : "السؤال التالي";
}

document.getElementById('nextBtn').addEventListener('click', ()=>{
  if(current < QUESTIONS.length - 1){
    current++;
    renderQuestion();
    window.scrollTo({top:0, behavior:'smooth'});
  } else {
    showResult();
  }
});

function showResult(){
  quizView.style.display = 'none';
  resultView.style.display = 'block';

  const missed = [];
  let score = 0;
  QUESTIONS.forEach((item, i)=>{
    if(answers[i] === correctPos[i]) score++; else missed.push(i);
  });
  const pct = Math.round((score / QUESTIONS.length) * 100);
  const pass = pct >= 60;

  document.getElementById('resultName').textContent = "نتيجة الطالبة: " + studentName;
  document.getElementById('scoreNum').textContent = pct + "%";
  document.getElementById('scoreDen').textContent = score + " من " + QUESTIONS.length + " إجابة صحيحة";
  const badge = document.getElementById('badge');
  badge.textContent = pass ? "ناجحة ✓" : "لم تصلي بعد إلى حد النجاح (60%)";
  badge.className = "badge " + (pass ? "pass" : "fail");

  const box = document.getElementById('weakBox');
  box.innerHTML = "";
  const title = document.getElementById('weakTitle');

  if(missed.length === 0){
    title.textContent = "أداء ممتاز";
    const p = document.createElement('p');
    p.className = 'weak-intro';
    p.textContent = "أجبتِ عن جميع الأسئلة إجابة صحيحة، ولا توجد نقاط ضعف ظاهرة في هذا الاختبار. حافظي على مستواك بالتدرّب على الحوارات بصوت مسموع، وحاولي استخدام هذه العبارات في حصصك الفعلية.";
    box.appendChild(p);
  } else {
    title.textContent = "نقاط الضعف وما تحتاجين إلى تقويته";
    const intro = document.createElement('p');
    intro.className = 'weak-intro';
    intro.textContent = missed.length === 1
      ? "أخطأتِ في سؤال واحد فقط، وهذا تفصيله:"
      : "أخطأتِ في " + missed.length + " أسئلة، وهذا تفصيل كل نقطة وكيف تقوّينها:";
    box.appendChild(intro);
    missed.forEach((qi)=>{
      const wk = WEAK[qi];
      const div = document.createElement('div');
      div.className = 'weak-item';
      const h = document.createElement('div');
      h.className = 'weak-h';
      h.textContent = wk.w;
      const t = document.createElement('div');
      t.className = 'weak-t';
      t.textContent = wk.f;
      div.appendChild(h);
      div.appendChild(t);
      box.appendChild(div);
    });
  }

  const tips = [];
  if(pass){
    tips.push("نتيجة جيدة، وأنتِ مستعدة لمتابعة الدورة بثقة.");
  } else {
    tips.push("تحتاجين إلى مراجعة النقاط الموضحة أعلاه قبل المتابعة، ثم إعادة تمثيل الحوارات المرتبطة بها.");
  }
  tips.push("مثّلي الحوارات بصوت مسموع مع زميلة أو أمام المرآة؛ فالحفظ الشفهي يثبّت العبارات أفضل من القراءة الصامتة.");
  tips.push("ميّزي دائمًا بين العبارة القصيرة السريعة والعبارة المطوّلة، واختاري بحسب الموقف: طفل خجول، طفل محبط، أم متحفظة.");

  const tList = document.getElementById('tipsList');
  tList.innerHTML = "";
  tips.forEach(t=>{
    const li = document.createElement('li');
    li.textContent = t;
    tList.appendChild(li);
  });

  window.scrollTo({top:0, behavior:'smooth'});
  sendToSheet();
}
</script>
</body>
</html>
